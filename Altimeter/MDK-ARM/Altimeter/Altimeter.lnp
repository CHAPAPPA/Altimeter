--cpu Cortex-M0+
"altimeter\startup_stm32g031xx.o"
"altimeter\main.o"
"altimeter\stm32g0xx_it.o"
"altimeter\stm32g0xx_hal_msp.o"
"altimeter\throttle.o"
"altimeter\watchdog_kick.o"
"altimeter\dps368.o"
"altimeter\ssd1309.o"
"altimeter\button.o"
"altimeter\settings.o"
"altimeter\altimeter_fsm.o"
"altimeter\stm32g0xx_hal_i2c.o"
"altimeter\stm32g0xx_hal_i2c_ex.o"
"altimeter\stm32g0xx_hal_rcc.o"
"altimeter\stm32g0xx_hal_rcc_ex.o"
"altimeter\stm32g0xx_ll_rcc.o"
"altimeter\stm32g0xx_hal_flash.o"
"altimeter\stm32g0xx_hal_flash_ex.o"
"altimeter\stm32g0xx_hal_gpio.o"
"altimeter\stm32g0xx_hal_dma.o"
"altimeter\stm32g0xx_hal_dma_ex.o"
"altimeter\stm32g0xx_ll_dma.o"
"altimeter\stm32g0xx_hal_pwr.o"
"altimeter\stm32g0xx_hal_pwr_ex.o"
"altimeter\stm32g0xx_hal_cortex.o"
"altimeter\stm32g0xx_hal.o"
"altimeter\stm32g0xx_hal_exti.o"
